{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:error": "playwright test --config e2e/playwright.error.config.ts",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:list": "playwright test --list --config e2e/playwright.config.ts",
    "lighthouse:desktop": "tsx scripts/run-lighthouse.ts --preset=desktop",
    "lighthouse:mobile": "tsx scripts/run-lighthouse.ts --preset=mobile",
    "lighthouse": "npm run lighthouse:desktop && npm run lighthouse:mobile",
    "lighthouse:assert": "tsx scripts/assert-lighthouse-scores.ts",
    "lighthouse:audit": "npm run lighthouse && npm run lighthouse:assert"
  },
  "dependencies": {
    "@bmad/shared": "*",
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "isbot": "^5.1.31",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "chrome-launcher": "^1.2.1",
    "jsdom": "^28.1.0",
    "lighthouse": "^13.1.0",
    "pg": "^8.20.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
